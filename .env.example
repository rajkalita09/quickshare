# Public URL used in share links and QR codes.
# Local Flask:  http://127.0.0.1:5000
# Local Docker: http://127.0.0.1:8000
# AWS EC2:      http://YOUR_EC2_PUBLIC_IP:8000
# With HTTPS:   https://your-domain.example
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Change this before deploying.
SECRET_KEY=change-me-in-deployment

# Maximum original file size in bytes. Default is 25 MB.
MAX_UPLOAD_BYTES=26214400

# Share lifetime in seconds. Default is 10 minutes.
EXPIRY_SECONDS=600

# Optional local paths. Docker Compose overrides these to /app/data and /app/uploads.
# DATA_DIR=./data
# UPLOAD_DIR=./uploads

CLEANUP_INTERVAL_SECONDS=30
UPLOAD_RATE_LIMIT=20
UPLOAD_RATE_WINDOW_SECONDS=600
